# Generated by Terraform
#
# SSH configuration for the VM
#
#   ssh_aliases      = ${join(" ", ssh_aliases)}
#   ssh_aliases_ipv6 = %{ if public_IPv6 != "" }${join(" ", ssh_aliases_ipv6)}%{ endif }
#   ssh_user         = ${ssh_user}
#   ssh_log_level    = ${ssh_log_level}
#   public_IPv4      = ${public_IPv4}
#   public_IPv6      = ${public_IPv6}
#   ssh_port         = ${ssh_port}
#   git.commit       = ${git.commit}
#   git.remote_url   = ${git.remote_url}
#   git.source       = ${git.source}
#   git.is_dirty     = ${git.is_dirty}
#
Host ${join(" ", ssh_aliases)} ${join(" ", ssh_aliases_ipv6)}
   User ${ssh_user}
   Port ${ssh_port}
   LogLevel ${ssh_log_level}

Host ${join(" ", ssh_aliases)}
   HostName ${public_IPv4}
%{ if public_IPv6 != "" }
Host ${join(" ", ssh_aliases_ipv6)}
   HostName ${public_IPv6}%{ endif }