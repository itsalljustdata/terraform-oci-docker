#cloud-config
#
#   git.commit       = ${git.commit}
#   git.remote_url   = ${git.remote_url}
#   git.source       = ${git.source}
#   git.is_dirty     = ${git.is_dirty}
#
timezone: ${coalesce(vm_timezone, "UTC")}
#
# SSH configuration
#
allow_public_ssh_keys: true
ssh_pwauth: ${vm_password != "" || vm_password_hash != ""}
ssh_quiet_keygen: true
# no_ssh_fingerprints: true
# authkey_hash: sha512
%{ if length(vm_ssh_authorized_keys) > 0 ~}
ssh_authorized_keys:
%{ for key in vm_ssh_authorized_keys ~}
  - ${jsonencode(key)}
%{ endfor ~}
%{ endif ~}
ssh_publish_hostkeys:
  blacklist: [rsa]
  enabled: true
ssh:
  emit_keys_to_console: false
#
# Block volume mounts (${length(block_vols)}) configuration
#
%{ if length(block_vols) > 0 ~}
mounts:
%{ for mount in block_vols ~}
  # 
  # display_name   : ${mount.display_name}
  # size           : ${mount.size_in_mbs} MB (${mount.size_in_gbs} GB)
  # ocid           : ${mount.ocid}
  # compartment_id : ${mount.compartment_id}
  - ["${mount.device}","${mount.path}","${mount.fs_type}","${join(",", mount.mount_options)}","0","2"]
%{ endfor ~}
%{ else ~}
  # No block volume mounts specified
%{ endif ~}
#
# Packages
#
package_update: true
package_upgrade: true
%{ if length(packages) == 0 ~}
# packages:
#   No packages specified
%{ else ~}
packages:
%{ for pkg in packages ~}
  - ${pkg}
%{ endfor ~}
%{ endif ~}
#
# User configuration
#
disable_root: ${!contains(theUsers, "root")}
%{ if length(theUsers) == 0 ~}
# users:
#   No users specified
%{ else ~}
users:
%{ for user in theUsers ~}
  - name: ${user}
    shell: /bin/bash
%{ if user == "root" ~}
    ssh_redirect_user: false
%{ else ~}
    sudo: "ALL=(ALL) NOPASSWD:ALL"
%{ endif ~}
    lock_passwd: ${vm_password == "" && vm_password_hash == ""}
%{ if vm_password != "" ~}
    plain_text_passwd: ${jsonencode(vm_password)}
%{ else ~}
%{ if vm_password_hash != "" ~}
    passwd: ${jsonencode(vm_password_hash)}
%{ else ~}
    # [WARNING] : No password or hash provided, account will be locked
%{ endif ~}
%{ endif ~}
%{ if length(vm_ssh_authorized_keys) > 0 ~}
    ssh_authorized_keys:
%{ for key in vm_ssh_authorized_keys ~}
      - ${jsonencode(key)}
%{ endfor ~}
%{ endif ~}
%{ endfor ~}
%{ endif ~}
%{ if ansible.enabled && length(ansible.playbooks) > 0 ~}
#
# Ansible configuration
#
ansible:
  package_name: ansible-core
  install_method: distro
  run_user: ${vm_user}
  setup_controller:
    repositories:
      - path: /home/${vm_user}/ansible-repo
        source: ${ansible.repository}
    run_ansible:
%{for playbook in ansible.playbooks ~}
      - playbook_dir: /home/${vm_user}/ansible-repo
        playbook_name: ${playbook.name}
%{ if length(playbook.vars) > 0 ~}
        extra_vars: '${jsonencode({ for var in playbook.vars : var.key => var.value })}'
%{ endif ~}
%{ endfor ~}
%{ else }
#
# No Ansible configuration
#
%{ endif ~}
#
# Writing cloud init files
#
%{ if length(cloud_init_files) == 0 ~}
# write_files:
#   No cloud init files specified
%{ else ~}
write_files:
%{ if encode_files ~}
  # Encode mode enabled, file content will be base64 encoded
  # to write the actual file content, set encode_files = false
%{ else ~}
  # To hide file content, set encode_files = true
%{ endif ~}
%{ for name, file in cloud_init_files ~}
  - path: ${coalesce(try(file.path, null), "/usr/local/sbin")}/${coalesce(try(file.name, null), name)}
    permissions: '${coalesce(try(file.permissions, null), "0755")}'
    owner: ${coalesce(try(file.owner, null), "root:root")}
    defer: ${coalesce(try(file.defer, null), false)}
%{ if encode_files ~}
    encoding: b64 # ASCII Content Length (bytes): ${length(file.content)}
    content: ${base64encode(file.content)}
%{ else ~}
    content: |
      ${replace(trimspace(file.content), "\n", "\n      ")}
%{ endif ~}
%{ endfor ~}
%{ endif ~}
#
# Boot commands
#
bootcmd:
  - if [ -x /usr/bin/rescan-scsi-bus.sh ]; then cloud-init-per once rescan-scsi /usr/bin/rescan-scsi-bus.sh; fi}
#
# Run commands
#
runcmd:
  - systemctl daemon-reload
%{ for mount in block_vols ~}
  - [ bash, -c, "systemctl start \"$(systemd-escape --path --suffix=automount '${mount.path}')\"" ] # ${mount.display_name}
%{ endfor ~}
  - chown -R ${vm_user}:${vm_user} /home/${vm_user}
%{ if length(runcmd_files) == 0 ~}
  # No runcmd files specified
%{ else ~}
%{ for name in runcmd_files ~}
  - bash /usr/local/sbin/${coalesce(try(cloud_init_files[name].name, null), name)}
%{ endfor ~}
%{ endif ~}