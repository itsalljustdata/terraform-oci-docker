#!/bin/bash
set -eu

echo "Starting mount-block-volumes script"

VM_NAME="${vm_name}"
VM_DIR="/mnt/data/${vm_name}"
APP_CONFIG_DIR="$${VM_DIR}/app_config"

login_iscsi_target() {
  local target_ip="$${1:-169.254.2.2}"
  local target_port="$${2:-3260}"

  if ! command -v iscsiadm >/dev/null 2>&1; then
    echo "iscsiadm not installed; cannot login to OCI iSCSI targets"
    return 1
  fi

  echo "Attempting OCI iSCSI discovery/login via $${target_ip}:$${target_port}"
  local discovered_targets
  discovered_targets="$(iscsiadm -m discovery -t sendtargets -p "$${target_ip}:$${target_port}" 2>/dev/null || true)"

  if [ -n "$${discovered_targets}" ]; then
    while read -r target_record; do
      [ -n "$${target_record}" ] || continue
      local target_iqn
      target_iqn="$(printf '%s\n' "$${target_record}" | awk '{print $2}')"
      [ -n "$${target_iqn:-}" ] || continue
      iscsiadm -m node -T "$${target_iqn}" -p "$${target_ip}:$${target_port}" -l >/dev/null 2>&1 || true
    done <<< "$${discovered_targets}"
  fi

  sleep 5

  if iscsiadm -m session 2>/dev/null | grep -q 'iqn\.'; then
    return 0
  fi

  return 1
}

find_valid_disk() {
  local preferred="$1"

  find_partition_or_disk() {
    local device="$1"
    [ -b "$device" ] || return 1

    local resolved="$(readlink -f "$device" 2>/dev/null || printf '%s' "$device")"
    case "$resolved" in
      /dev/sda|/dev/sda*|/dev/vda|/dev/vda*) return 1 ;;
    esac

    local partition="$(lsblk -lnpo NAME,TYPE "$resolved" 2>/dev/null | awk '$2 == "part" { print $1; exit }')"
    if [ -n "$partition" ] && [ -b "$partition" ]; then
      echo "$partition"
      return 0
    fi

    if lsblk -lnpo TYPE "$resolved" 2>/dev/null | grep -q '^disk$'; then
      echo "$resolved"
      return 0
    fi

    return 1
  }

  if [ -n "$${preferred:-}" ]; then
    if DEV="$(find_partition_or_disk "$preferred" 2>/dev/null)" && [ -n "$DEV" ]; then
      echo "$DEV"
      return 0
    fi
  fi

  for candidate in /dev/oracleoci/* /dev/sd* /dev/vd*; do
    [ -b "$candidate" ] || continue
    if DEV="$(find_partition_or_disk "$candidate" 2>/dev/null)" && [ -n "$DEV" ]; then
      echo "$DEV"
      return 0
    fi
  done

  return 1
}

%{ for mount in mount_entries ~}
mkdir -p "${mount.path}"

echo "Evaluating mount: device=${mount.device} path=${mount.path} fs_type=${mount.fs_type} options=${join(",", mount.mount_options)}" 1>&2

if mountpoint -q "${mount.path}"; then
  echo "Mount point already mounted: ${mount.path}"
else
  DEV="$(find_valid_disk "${mount.device}" || true)"

  if [ -z "$${DEV:-}" ] || [ ! -b "$${DEV}" ]; then
    echo "No valid secondary disk detected yet for ${mount.path}; preferred=${mount.device}"
    login_iscsi_target "169.254.2.2" "3260" || true
    DEV="$(find_valid_disk "${mount.device}" || true)"
  fi

  if [ -z "$${DEV:-}" ] || [ ! -b "$${DEV}" ]; then
    echo "Skipping mount for ${mount.path}: no valid secondary disk detected; preferred=${mount.device}"
  else
    echo "Using disk device for ${mount.path}: $${DEV}" 1>&2
    if ! blkid "$${DEV}" >/dev/null 2>&1; then
      mkfs.${mount.fs_type} "$${DEV}"
    fi

    mount -o ${join(",", mount.mount_options)} "$${DEV}" "${mount.path}"

    if ! grep -q "${mount.path}" /etc/fstab; then
      UUID="$(blkid -s UUID -o value "$${DEV}")"
      printf '%s %s %s %s 0 2\n' "UUID=$${UUID}" "${mount.path}" "${mount.fs_type}" "${join(",", mount.mount_options)}" >> /etc/fstab
    fi
  fi
fi
%{ endfor ~}

ensure_app_root_links() {
  
  local app_root="$1$2"
  local target_root="$2"
  mkdir -p "$${app_root}"

  [ -d "$${app_root}" ] || return 0

  for entry in "$${app_root}"/*; do
    [ -d "$${entry}" ] || continue
    name="$(basename "$${entry}")"
    target="$${target_root}/$${name}"

    if [ ! -e "$${target}" ] && [ ! -L "$${target}" ]; then
      echo "Creating symlink for $${entry} -> $${target}" 1>&2
      ln -s "$${entry}" "$${target}"
    fi
  done
}

ensure_app_root_links "$${APP_CONFIG_DIR}" "/etc"
ensure_app_root_links "$${APP_CONFIG_DIR}" "/var/lib"
ensure_app_root_links "$${APP_CONFIG_DIR}" "/opt/docker"