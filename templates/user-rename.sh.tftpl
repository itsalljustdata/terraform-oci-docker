# Generated by Terraform
#
#   vm_user          = '${vm_user}'
#   vm_user_rename   = '${vm_user_rename}'
#   
#   git.commit       = ${git.commit}
#   git.remote_url   = ${git.remote_url}
#   git.source       = ${git.source}
#   git.is_dirty     = ${git.is_dirty}
#

if [ -n "${vm_user_rename}" ] && [ "${vm_user}" != "${vm_user_rename}" ]; then
    echo "INFO: '${vm_user}' renaming to '${vm_user_rename}'"
else
    echo "INFO: '${vm_user}' not being renamed"
    exit 0
fi

#
# Check new user doesn't already exist
#
greppy="^${vm_user_rename}:"
for checkFile in /etc/passwd /etc/group; do
    file=$$(grep -lE "$$greppy" "$$checkFile" 2>/dev/null || true)
    if [ -n "$$file" ]; then
        echo "ERROR: Cannot rename '${vm_user}' to '${vm_user_rename}', already exists : $$checkFile"
        exit 1
    fi
done

for f in /etc/group /etc/shadow /etc/passwd; do
    sed -i "s|${vm_user}:|${vm_user_rename}:|g" "$${f}"
done

greppy="^%${vm_user} "
files=$$(grep -lE "$${greppy}" /etc/sudoers.d/* 2>/dev/null || true)

for file in $${files}; do
    echo "DEBUG: Updating '$${file}'"
    sed -i "s|$${greppy}|%${vm_user_rename} |g" "$${file}"
done

echo "INFO: '${vm_user}' renamed to '${vm_user_rename}'"