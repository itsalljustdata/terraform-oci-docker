[Unit]
Description=Mount Bastion block volumes
After=local-fs.target
Before=sshd.service
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/wait-for-block-volume.sh
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
