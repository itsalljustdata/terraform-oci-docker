#!/bin/bash
set -eu


echo "Configuring firewall..."
echo "Checking for firewall tools..."
firewallCmdFound=`command -v firewall-cmd >/dev/null 2>&1`
ufwFound=`command -v ufw >/dev/null 2>&1`

echo "firewall-cmd : $${firewallCmdFound}"
echo "ufw          : $${ufwFound}"

ports=(22)
if [[ "${ssh_public_port}" != "22" ]]; then
  ports+=("${ssh_public_port}")
fi

if [ "$${firewallCmdFound}" != "" ]; then
  systemctl enable --now firewalld
  firewall-cmd --add-service=ssh --permanent
  for port in "${ports[@]}"; do
    firewall-cmd --permanent --add-port=$${port}/tcp --quiet
  done
  firewall-cmd --reload --quiet
  firewall-cmd --list-all --quiet
elif [ "$${ufwFound}" != "" ]; then
  ufw default deny incoming
  ufw default allow outgoing
  ufw allow OpenSSH
  for port in "${ports[@]}"; do
    ufw allow $${port}/tcp
  done
  ufw --force enable
  for stat in "numbered verbose"; do
    ufw status $${stat}
  done
else
  echo "WARNING: No supported firewall found, skipping firewall configuration" >&2
  exit 0
fi
echo "Firewall configuration completed."