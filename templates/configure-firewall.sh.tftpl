#!/bin/bash
set -eu


echo "INFO: Configuring firewall..."
echo "INFO: Checking for firewall tools..."
cmdFirewallCmd=`command -v firewall-cmd || echo ""`
cmdUfw=`command -v ufw || echo ""`

echo "DEBUG: firewall-cmd : $${cmdFirewallCmd}"
echo "DEBUG: ufw          : $${cmdUfw}"

ports=(22)
if [[ "${ssh_public_port}" != "22" ]]; then
  ports+=("${ssh_public_port}")
fi

if [ "$${cmdFirewallCmd}" != "" ]; then
  systemctl enable --now firewalld
  firewall-cmd --add-service=ssh --permanent
  for port in "$${ports[@]}"; do
    firewall-cmd --permanent --add-port=$${port}/tcp --quiet
  done
  firewall-cmd --reload --quiet
  firewall-cmd --list-all --quiet
elif [ "$${cmdUfw}" != "" ]; then
  ufw default deny incoming
  ufw default allow outgoing
  ufw allow OpenSSH
  for port in "$${ports[@]}"; do
    ufw allow $${port}/tcp
  done
  ufw --force enable
  for stat in "numbered verbose"; do
    ufw status $${stat}
  done
else
  echo "ERROR: No supported firewall found (firewall-cmd, ufw), skipping firewall configuration" >&2
  exit 1
fi
echo "INFO: Firewall configuration completed."
exit 0