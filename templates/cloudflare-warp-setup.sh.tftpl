#!/bin/bash
set -eu

if [ "${enabled}" == "true" ]; then
    :
else
    echo "INFO: warp.enabled = false"
    exit 0
fi

%{if enabled }
# Oracle Linux does not provide subscription-manager, so skip RHSM-only repo setup
# and install the EPEL repo directly instead.
apt install -y "https://dl.fedoraproject.org/pub/epel/epel-release-latest-$(rpm -E %rhel).noarch.rpm"
curl -fsSL https://pkg.cloudflareclient.com/cloudflare-warp-ascii.repo | tee /etc/apt.repos.d/cloudflare-warp.repo 
apt install -y cloudflare-warp
printf 'net.ipv4.ip_forward = 1\nnet.ipv6.conf.all.forwarding = 1\nnet.ipv6.conf.all.accept_ra = 2\n' | tee /etc/sysctl.d/99-zzz-cloudflare-warp-connector.conf
sysctl --system

warp-cli connector new ${tunnel_token}
warp-cli connect
%{endif}