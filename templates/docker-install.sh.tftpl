#!/bin/bash
set -eu

%{ if enabled == "true" ~}
echo "------------------------------------------------------------"
echo "Docker install"
echo "------------------------------------------------------------"

apt-get -qq install --quiet -y ca-certificates curl
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc

# Add the repository to Apt sources:
sudo tee /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $(. /etc/os-release && echo "$${UBUNTU_CODENAME:-$VERSION_CODENAME}")
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF

apt-get -qq update

apt-get -qq install --quiet -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

apt-get -qq autoremove --quiet -y

dirRoot="/mnt/data/$(hostname -s)"

dockerDataDir="$${dirRoot}/docker"
containerdDataDir="$${dirRoot}/containerd"
containerd_config_path="/etc/containerd/config.toml"
export dockerDataDir containerdDataDir containerd_config_path
for dir in "$${dockerDataDir}" "$containerdDataDir"; do
    mkdir -p "$dir"
    chown root:docker "$dir"
    chmod 775 "$dir"
done
python3 << 'pyEOF'
import os
import json
docker_data_dir = os.environ.get("dockerDataDir")
daemon_json_path = "/etc/docker/daemon.json"
if docker_data_dir:
    print(f"INFO: Docker data directory is {docker_data_dir}")
    if os.path.exists(daemon_json_path):
        import json
        with open(daemon_json_path, "r") as f:
            config = json.load(f)
    else:
        config = {}
    
    config["data-root"] = docker_data_dir
    with open(daemon_json_path, "w") as f:
        json.dump(config, f, indent=4)

    print(f"INFO: Docker daemon.json updated with data-root {docker_data_dir}")

pyEOF

python3 << 'pyEOF2'
from pathlib import Path
import os
containerd_config_path = os.environ.get("containerd_config_path")
containerd_data_dir = os.environ.get("containerdDataDir")
config_path = Path(containerd_config_path)
if config_path.exists():
    config = config_path.read_text().split("\n")
else:
    print (f"WARNING: Containerd config path ('{containerd_config_path}') does not exist. Using default configuration.")
    config = []

rootLine = f'root = "{containerd_data_dir}"'
for i, line in enumerate(config):
    if "root=" in line.strip().replace(' ',''):
        config[i] = rootLine
        break
else:
    config.append(rootLine)

config_path.write_text("\n".join(config))
pyEOF2

srvs="docker containerd"
actions="enable restart"
for srv in $${srvs}; do
    for a in $${actions}; do
        echo "INFO: $${a} $${srv}"
        systemctl $${a} --now $${srv} 2>&1
    done
done

if id -u "${vm_user}" >/dev/null 2>&1; then
    usermod -aG docker "${vm_user}" || true
fi

gitDir="$${dirRoot}/git"
if [ -d "$${gitDir}" ]; then
    echo "INFO: git directory exists at $${gitDir}"
else
    mkdir -p "$${gitDir}"
    chown -R 1000:1000 "$${gitDir}"
    chmod 775 "$${gitDir}"
    echo "INFO: git directory created at $${gitDir}"
fi
homeGit="/home/${vm_user}/git"
if [ -d "$${homeGit}" ] && [ ! -L "$${homeGit}" ]; then
    echo "WARNING: Actual home git directory exists at $${homeGit}"
elif [ -L "$${homeGit}" ]; then
    echo "INFO: git symlink already exists at $${homeGit}"
else
    echo "INFO: Creating symlink from $${gitDir} to $${homeGit}"
    ln -s "$${gitDir}" "$${homeGit}" || true
fi

docker --version
%{ else ~}
echo "INFO: docker.enabled = false"
%{ endif ~}
