#!/bin/bash
set -eu

if [ "${enabled}" == "true" ]; then
    echo "INFO: cloudflared.enabled = true"
else
    echo "INFO: cloudflared.enabled = false"
    exit 0
fi

if [ -f /etc/os-release ]; then 
    . /etc/os-release
fi

theGPG=/usr/share/keyrings/cloudflare-main.gpg
thisArch=$(dpkg --print-architecture)

# echo "INFO: thisArch = $${thisArch}"

# Add cloudflare gpg key 
install -d -m 0755 $(dirname "$${theGPG}")
curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg -o "$${theGPG}"


cat >/etc/apt/sources.list.d/cloudflared.sources <<EOF
Types: deb
URIs: https://pkg.cloudflare.com/cloudflared
Suites: any
Components: main
Signed-By: $${theGPG}
Architectures: $${thisArch}
EOF

apt-get -qq update
apt-cache policy cloudflared
apt-get -qq install -y --no-install-recommends cloudflared

echo "------------------------------------------------------"
echo "Version: `cloudflared version --short`"
echo "------------------------------------------------------"


cloudflared service install "${tunnel_token}"

echo "------------------------------------------------------"
echo "Script Completed"
echo "------------------------------------------------------"